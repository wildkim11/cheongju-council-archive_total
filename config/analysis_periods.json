          "meeting_date": "2016-06-20",
          "excerpts": [
            {
              "char_start": 5736,
              "char_end": 5802,
              "quote": "전반기 임기가 6월 30일 자로 마감되는 것이 맞습니다. 그래서 7월 1일부터 원 구성을 해서 일정을 소화시켜야 되는데",
              "quote_sha256": "5d7c375dea8a9938ce2da2aab11345c542636bbf1bf75db002f830424c5168ce",
              "speaker_name": "오병호",
              "speaker_role": "의사팀장",
              "purpose": "calendar_boundary"
            },
            {
              "char_start": 6798,
              "char_end": 6840,
              "quote": "그건 후임 의장 임기, 선거하기 전날까지 전반기 의장이 하도록 돼 있습니다.",
              "quote_sha256": "d34cf9fcd7e27320ebdc5fffebf1e886b42794be1179fa49df0b1918faa89ff1",
              "speaker_name": "오병호",
              "speaker_role": "의사팀장",
              "purpose": "personal_office_contrast"
            }
          ],
          "interpretation_rule": "explicit_month_day_boundary_in_meeting_year"
        }
