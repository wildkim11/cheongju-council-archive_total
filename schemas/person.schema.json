{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Person",
  "type": "object",
  "required": [
    "person_id",
    "name"
  ],
  "properties": {
    "person_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "official_profile_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "official_profile_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "portrait": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "local_path": {
          "type": "string"
        },
        "checked_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
